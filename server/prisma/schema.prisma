datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum DeployStatus {
  draft
  building
  ready
  failed
}

enum Attendance {
  hadir
  ragu
  tidak_hadir
}

enum PaymentStatus {
  unpaid
  pending_approval
  approved
  rejected
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  invitations  Invitation[]

  @@map("users")
}

model Invitation {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String       @unique
  templateKey        String       @default("minimalist") // "minimalist" | "floral" | "dark-luxury"
  contentJson        Json
  vercelProjectId    String?
  vercelProjectName  String?
  latestDeploymentId String?
  deploymentUrl      String?
  deployStatus       DeployStatus @default(draft)
  paymentStatus      PaymentStatus @default(unpaid)
  paymentProofUrl    String?
  paymentAmount      Int?          @default(99000)
  paymentApprovedAt  DateTime?
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  wishes             GuestWish[]

  @@index([userId])
  @@index([slug])
  @@map("invitations")
}

model GuestWish {
  id           String      @id @default(uuid())
  invitationId String
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestName    String
  attendance   Attendance  @default(hadir)
  guestCount   Int?        @default(1)
  message      String
  createdAt    DateTime    @default(now())

  @@index([invitationId])
  @@map("guest_wishes")
}

model PresetSong {
  id        String   @id @default(uuid())
  title     String
  artist    String?
  audioUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("preset_songs")
}

model TemplateCatalog {
  id           String   @id @default(uuid())
  templateKey  String   @unique // "minimalist" | "floral" | "dark-luxury"
  name         String
  description  String
  thumbnailUrl String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("template_catalogs")
}
